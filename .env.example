# =========================================================
# manju · AI 短剧生成器环境变量配置
# 全部接入 火山引擎方舟（豆包 / Seedream / Seedance）
# 获取 API Key：https://console.volcengine.com/ark
# =========================================================

# 火山引擎方舟 API Key（必填，用于文本/生图/生视频）
ARK_API_KEY=your_ark_api_key_here

# 豆包大模型（文本：写剧本 / 分镜 / 提示词）
DOUBAO_LLM_MODEL=doubao-1-5-pro-32k-250115

# 豆包 Seedream（文生图：角色定妆、场景、关键帧）
SEEDREAM_MODEL=doubao-seedream-3-0-t2i-250415

# 豆包 Seedance（图生视频 / 文生视频：成片片段）
SEEDANCE_MODEL=doubao-seedance-1-0-pro-video-250528

# 可选：火山方舟区域（默认北京）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
